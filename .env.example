# Supabase (Project Settings → API). En local: los da `npm run local:arrancar`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Dirección pública del sitio, sin barra final (para enlaces al compartir y el sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3110
# Aviso por correo de cada comentario nuevo (opcional). Sin esto, los comentarios solo se ven en el panel.
RESEND_API_KEY=
# A quién avisar (el correo del autor). Varios separados por coma.
CORREO_AVISOS=
# Remitente con el dominio verificado en Resend, ej: Tu página <avisos@wagnerperezeulufi.com>
CORREO_REMITENTE=
# Tienda con Mercado Pago (cuenta del autor). Sin estas tres, la tienda muestra los productos
# pero no cobra (ofrece WhatsApp).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Clave de servicio de Supabase: SOLO para confirmar pagos. Nunca con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Solo pruebas locales con scripts/mp-falso.mjs:
# MERCADOPAGO_API_URL=http://localhost:56399
